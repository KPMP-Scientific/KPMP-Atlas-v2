###################### code to do count of differential peaks FDR <0.1 from annotated excel #########\
library(openxlsx)\
\
\
excel_file <- "/Users/jeanninebasta/KPMPv2_DiffBind/summit_test/KPMPv2_AKI_CKDvHRT_DiffBind_Annotation_Results_DESeq_no_threshold_v8.xlsx"\
\
sheets <- getSheetNames(excel_file)\
\
summary_counts <- data.frame(\
  Sheet = character(),\
  Total_Peaks = numeric(),\
  FDR_lt_0.1 = numeric(),\
  stringsAsFactors = FALSE\
)\
\
for (sheet in sheets) \{\
  \
  df <- read.xlsx(excel_file, sheet = sheet)\
  \
  if (nrow(df) == 0) next\
  \
  total_count <- nrow(df)\
  sig_count   <- sum(df$FDR < 0.1, na.rm = TRUE)\
  \
  summary_counts <- rbind(summary_counts,\
                          data.frame(\
                            Sheet = sheet,\
                            Total_Peaks = total_count,\
                            FDR_lt_0.1 = sig_count\
                          ))\
\}\
\
print(summary_counts)}