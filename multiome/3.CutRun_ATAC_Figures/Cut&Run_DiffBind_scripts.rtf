fdr_thresh <- 0.1\
\
# -------------------------------\
# Get sheet names (histone marks)\
# -------------------------------\
sheet_names <- excel_sheets(combined_excel)\
\
# -------------------------------\
# Loop through sheets and create BED\
# -------------------------------\
for (sh in sheet_names) \{\
  \
  message("Processing: ", sh)\
  \
  df <- read_excel(combined_excel, sheet = sh) %>%\
    rename(\
      log2FC = Fold,\
      fdr = FDR,\
      gene_symbol = SYMBOL\
    ) %>%\
    filter(!is.na(fdr), fdr < fdr_thresh)\
  \
  # Create BED6 format\
  bed_df <- df %>%\
    mutate(\
      name = paste0(\
        gene_symbol,\
        "_log2FC=", round(log2FC, 2),\
        "_FDR=", signif(fdr, 2)\
      ),\
      score = 1000,\
      strand = "."\
    ) %>%\
    select(seqnames, start, end, name, score, strand)\
  \
  # Write BED file (tab-delimited, no header)\
  write_tsv(\
    bed_df,\
    file.path(output_dir, paste0(sh, "_FDR0.1.bed")),\
    col_names = FALSE\
  )\
\}\
\
