#Differential Binding Analysis\
#031426\
#Human KPMP reference and disease (biopsy) samples for KPMPv2 manuscript. \
#Perform differential analysis using DESeq and EdgeR for healthy vs disease samples. \
#v6- edgeR using peak set exported from object - Kidney_pEpi_PT-TL_Dual_Seurat_all-peaks_05162024.rda\
#v8- DESeq2 using peak set exported from object- Kidney_pEpi_PT-TL_Dual_Seurat_all-peaks_05162024.rda\
###########version 6- Kidney_pEpi_PT-TL_Dual_Seurat_all-peaks_05162024_peaks #################################\
\
#need to clean up bed file exported from object\
# R script to clean a BED file for DiffBind\
\
# Path to your original BED file\
input_bed <- "/Users/jeanninebasta/KPMPv2_DiffBind/Kidney_pEpi_PT-TL_Dual_Seurat_all-peaks_05162024_peaks/Kidney_pEpi_PT-TL_Dual_Seurat_all-peaks_05162025.bed"\
\
# Path to save the cleaned BED file\
output_bed <- "/Users/jeanninebasta/KPMPv2_DiffBind/Kidney_pEpi_PT-TL_Dual_Seurat_all-peaks_05162024_peaks/Kidney_pEpi_PT-TL_Dual_Seurat_all-peaks_05162025_cleaned.bed"\
\
# Load BED\
bed <- read.table(input_bed, header = FALSE, stringsAsFactors = FALSE)\
\
# Ensure BED has at least 6 columns\
if(ncol(bed) < 6)\{\
  stop("BED file must have at least 6 columns.")\
\}\
\
# Column 4 (Name) - replace "." with unique peak names\
bed$V4[bed$V4 == "."] <- paste0("peak_", seq_len(sum(bed$V4 == ".")))\
\
# Column 5 (Score) - replace 0 with 1 (DiffBind doesn't like 0)\
bed$V5[bed$V5 == 0] <- 1\
\
# Column 6 (Strand) - replace "." with "+"\
bed$V6[bed$V6 == "."] <- "+"\
\
# Save cleaned BED file\
write.table(bed, output_bed, sep = "\\t", quote = FALSE, row.names = FALSE, col.names = FALSE)\
\
cat("Cleaned BED file saved to:", output_bed, "\\n")\
\
####################### EdgeR analysis, threshold 1, all results included ################\
library(DiffBind)\
library(openxlsx)\
rm(KPMP)\
# ---------------------------\
# Load sample sheet & DBA object\
# ---------------------------\
samples <- read.csv("/Users/jeanninebasta/KPMPv2_DiffBind/Kidney_pEpi_PT-TL_Dual_Seurat_all-peaks_05162024_peaks/KPMPv2_merge_tech_replicates_Kidney_pEpi_PT-TL_peaks_sample_key.csv",\
                    stringsAsFactors = FALSE)\
\
KPMP <- dba(sampleSheet = samples)\
KPMP\
\
# Check sample grouping\
print(table(samples$Condition))\
print(table(samples$Factor))\
print(table(samples$Tissue))\
\
setwd("/Users/jeanninebasta/KPMPv2_DiffBind/Kidney_pEpi_PT-TL_Dual_Seurat_all-peaks_05162024_peaks")\
\
# Create results list\
results_list_er_6 <- list()\
\
# Define contrasts\
contrast_defs <- list(\
  HRT_vs_AKI_CKD_er = c("Condition", "AKI_CKD", "HRT")\
)\
\
# Get all antibodies\
antibodies <- unique(KPMP$samples$Factor)\
\
for (ab in antibodies) \{\
  cat("\\n==============================\\n")\
  cat("Processing antibody:", ab, "\\n")\
  \
  # Subset antibody (fresh object each loop)\
  ab_mask <- KPMP$samples$Factor == ab\
  \
  dba_sub <- dba(KPMP, mask = ab_mask)\
  \
  # Count reads once\
  dba_sub <- dba.count(dba_sub, summits = FALSE, bUseSummarizeOverlaps = TRUE)\
  \
  # Make sure Condition is a factor with proper order\
  dba_sub$samples$Condition <- factor(dba_sub$samples$Condition,\
                                      levels = c("HRT", "AKI_CKD"))\
  \
  # Initialize list for this antibody\
  results_list_er_6[[ab]] <- list()\
  \
  # Loop over contrasts\
  for (cn in names(contrast_defs)) \{\
    cat(" Running contrast:", cn, "\\n")\
    \
    # Build one contrast at a time\
    dba_c <- dba.contrast(\
      dba_sub,\
      categories = DBA_CONDITION,\
      contrast = contrast_defs[[cn]],\
      minMembers = 2\
    )\
    \
    # Analyze with EdgeR\
    dba_c <- dba.analyze(\
      dba_c,\
      method = DBA_EDGER,\
      design = ~Condition,\
      bGreylist = FALSE,\
      bBlacklist = FALSE\
    )\
    \
    # Export all peaks (th=1)\
    rep <- dba.report(dba_c, method = DBA_EDGER, th = 1)\
    results_list_er_6[[ab]][[cn]] <- rep\
    cat("  -> Exported", length(rep), "peaks for", cn, "\\n")\
  \}\
\}\
\
# -------------------------------\
# Create Excel workbook\
# -------------------------------\
wb <- createWorkbook()\
\
for (ab in names(results_list_er_6)) \{\
  cat("Adding sheets for", ab, "\\n")\
  \
  for (cn in names(results_list_er_6[[ab]])) \{\
    rep_df <- as.data.frame(results_list_er_6[[ab]][[cn]])\
    # Add antibody and contrast columns\
    rep_df$Antibody <- ab\
    rep_df$Contrast <- cn\
    # Sheet name max 31 chars\
    sheet_name <- substr(paste0(ab, "_", cn), 1, 31)\
    \
    addWorksheet(wb, sheet_name)\
    writeData(wb, sheet_name, rep_df)\
  \}\
\}\
\
# Save workbook\
saveWorkbook(wb, "KPMPv2_AKI_CKDvHRT_DiffBind_EdgeR_no_threshold_v6.xlsx", overwrite = TRUE)\
cat("\\nWorkbook saved: KPMPv2_AKI_CKDvHRT_DiffBind_EdgeR_no_threshold_v6.xlsx\\n")\
\
