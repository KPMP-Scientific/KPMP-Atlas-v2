library(openxlsx)\
\
combined_excel <- "/Users/jeanninebasta/KPMPv2_DiffBind/summit_test/KPMPv2_AKI_CKDvHRT_DiffBind_Annotation_Results_DESeq_no_threshold_v8.xlsx"\
bed_dir <- "/Users/jeanninebasta/KPMPv2_DiffBind/summit_test/DESeq_threshold_fdr0.1_bed_files_v8"\
dir.create(bed_dir, showWarnings = FALSE)\
\
fdr_thresh <- 0.1\
\
# -------------------------------\
# Get sheet names\
# -------------------------------\
sheet_names <- excel_sheets(combined_excel)\
\
# -------------------------------\
# Create BED files (no coloring)\
# -------------------------------\
for (sh in sheet_names) \{\
  \
  message("Processing: ", sh)\
  \
  df <- read_excel(combined_excel, sheet = sh) %>%\
    rename(\
      log2FC = Fold,\
      fdr = FDR,\
      gene_symbol = SYMBOL\
    ) %>%\
    filter(!is.na(fdr), fdr < fdr_thresh)\
  \
  # BED6 format\
  bed_df <- df %>%\
    mutate(\
      chromStart = start - 1,   # convert to 0-based BED format\
      chromEnd   = end,\
      name = paste0(\
        gene_symbol,\
        "_log2FC=", round(log2FC, 2),\
        "_FDR=", signif(fdr, 2)\
      ),\
      score = 1000,\
      strand = "."\
    ) %>%\
    select(\
      seqnames,\
      chromStart,\
      chromEnd,\
      name,\
      score,\
      strand\
    )\
  \
  # Clean filename\
  clean_name <- gsub("[^A-Za-z0-9_]", "_", sh)\
  \
  write_tsv(\
    bed_df,\
    file.path(bed_dir, paste0(clean_name, "_FDR0.1.bed")),\
    col_names = FALSE\
  )\
\}\
\
