# TxDb and OrgDb\
txdb <- TxDb.Hsapiens.UCSC.hg38.knownGene\
orgdb <- org.Hs.eg.db\
# Output directory\
annot_output_dir <- "/Users/jeanninebasta/KPMPv2_DiffBind/Kidney_pEpi_PT-TL_Dual_Seurat_all-peaks_05162024_peaks"\
dir.create(annot_output_dir, recursive = TRUE, showWarnings = FALSE)\
\
# Create a new Excel workbook\
wb <- createWorkbook()\
\
# Loop through results\
for (ab in names(results_list_er_6)) \{\
  for (contrast in names(results_list_er_6[[ab]])) \{\
    \
    cat("Annotating:", ab, contrast, "\\n")\
    \
    gr <- results_list_er_6[[ab]][[contrast]]\
    \
    # Skip if no EdgeR peaks\
    if (is.null(gr) || length(gr) == 0) \{\
      cat("  \uc0\u8594  Skipping: no EdgeR peaks\\n")\
      next\
    \}\
    \
    # Ensure GRanges\
    if (!inherits(gr, "GRanges")) \{\
      warning("  \uc0\u8594  Not a GRanges object, skipping ", ab, " ", contrast)\
      next\
    \}\
    \
    # Annotate\
    peak_anno <- annotatePeak(\
      gr,\
      TxDb = txdb,\
      annoDb = "org.Hs.eg.db",\
      tssRegion = c(-3000, 3000)\
    )\
    \
    anno_df <- as.data.frame(peak_anno)\
    anno_df$Antibody <- ab\
    anno_df$Contrast <- contrast\
    \
    # Excel-safe sheet name\
    sheet_name <- substr(\
      gsub("[^A-Za-z0-9_]", "_", paste0(ab, "_", contrast)),\
      1, 31\
    )\
    \
    addWorksheet(wb, sheet_name)\
    writeData(wb, sheet_name, anno_df)\
    \
    cat("  \uc0\u8594  Annotated", nrow(anno_df), "peaks\\n")\
  \}\
\}\
\
# Save workbook\
saveWorkbook(wb, file = file.path(annot_output_dir, "KPMPv2_AKI_CKDvHRT_DiffBind_EdgeR_no_threshold_v6_Annotated_Results.xlsx"), overwrite = TRUE)\
